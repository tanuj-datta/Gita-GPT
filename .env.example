# Google Gemini API Key (Required for AI responses and dynamic sloka generation)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database URL (Optional - if omitted, chats are saved locally in browser storage)
# e.g., postgresql://username:password@localhost:5432/gita_gpt
DATABASE_URL=

# NextAuth Configuration (Optional - for Google OAuth login)
AUTH_SECRET=your_auth_secret_here
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
